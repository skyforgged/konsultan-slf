From 1d1a09f5e98ea5d37ede7c8935d1eb5a95eb7d25 Mon Sep 17 00:00:00 2001
From: "Claude (audit)" <noreply@anthropic.com>
Date: Thu, 15 Oct 2026 04:20:02 +0000
Subject: [PATCH 6/8] feat(ci): fail production builds that still use the
 placeholder site origin

astro.config falls back to http://konsultan-slf.lan when neither SITE_URL nor
VERCEL_PROJECT_PRODUCTION_URL is set. Every existing SEO check only verifies that
origins are consistent with each other, so a production deploy with .lan canonicals,
sitemap and robots would pass. The check now fails when VERCEL_ENV=production (or
REQUIRE_PUBLIC_SITE_URL=1) and an origin is localhost/*.lan/*.local/etc.
NOTE: if Vercel production starts failing on this, the public canonical was wrong
before this change; set SITE_URL in the Vercel project.
---
 README.md                    |  2 ++
 scripts/check-seo-output.mjs | 13 +++++++++++++
 2 files changed, 15 insertions(+)

diff --git a/README.md b/README.md
index 3503d39..21fac10 100644
--- a/README.md
+++ b/README.md
@@ -66,6 +66,8 @@ Jika berjalan di Vercel, konfigurasi juga membaca `VERCEL_PROJECT_PRODUCTION_URL
 
 URL situs digunakan untuk canonical, Open Graph, data terstruktur, sitemap, dan robots.txt.
 
+Build dengan `VERCEL_ENV=production`, atau dengan `REQUIRE_PUBLIC_SITE_URL=1`, akan gagal di `scripts/check-seo-output.mjs` bila origin masih placeholder (`*.lan`, `localhost`, dan sejenisnya). Untuk build lokal/CI biasa pemeriksaan ini tidak aktif.
+
 ## Konten
 
 Konten disimpan sebagai Markdown di:
diff --git a/scripts/check-seo-output.mjs b/scripts/check-seo-output.mjs
index 632a174..99adc44 100644
--- a/scripts/check-seo-output.mjs
+++ b/scripts/check-seo-output.mjs
@@ -224,6 +224,19 @@ try {
   // Missing file is already reported above.
 }
 
+// Build produksi tidak boleh memakai origin placeholder (fallback konfigurasi: http://konsultan-slf.lan).
+// Kegagalan ini senyap karena semua pemeriksaan lain hanya menguji konsistensi origin, bukan kebenarannya.
+if (process.env.VERCEL_ENV === 'production' || process.env.REQUIRE_PUBLIC_SITE_URL === '1') {
+  const placeholderHosts = new Set();
+  for (const url of [...canonicalUrls, ...(robotsSitemapUrl ? [robotsSitemapUrl.href] : [])]) {
+    const { hostname } = new URL(url);
+    if (hostname === 'localhost' || hostname === '127.0.0.1' || /\.(lan|local|localhost|invalid|test|example)$/i.test(hostname)) placeholderHosts.add(hostname);
+  }
+  if (placeholderHosts.size > 0) {
+    failures.push(`Production build uses a placeholder site origin (${[...placeholderHosts].join(', ')}). Set SITE_URL to the public URL (or expose VERCEL_PROJECT_PRODUCTION_URL) before deploying.`);
+  }
+}
+
 if (failures.length) {
   console.error(`SEO output check failed: ${failures.length} issue(s) across ${pagesChecked} HTML pages.\n`);
   console.error(failures.map((failure) => `- ${failure}`).join('\n'));
-- 
