 src/layouts/ArticleLayout.astro         | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/components/shared/ArticleCard.astro b/src/components/shared/ArticleCard.astro
index dee759a..fd12868 100644
--- a/src/components/shared/ArticleCard.astro
+++ b/src/components/shared/ArticleCard.astro
@@ -19,5 +19,5 @@ const href = `/articles/${article.data.slug}/`;
   {article.data.category && <p class="mt-4 text-xs font-bold uppercase tracking-wider text-blue-700">{article.data.category}</p>}
   <Heading class="mt-3 text-lg font-bold leading-snug text-slate-950"><a href={href} class="hover:text-blue-700">{article.data.title}</a></Heading>
   <p class="mt-3 flex-1 text-sm leading-6 text-slate-600">{article.data.description}</p>
-  <div class="mt-5 flex items-center justify-between text-xs text-slate-500"><time datetime={article.data.pubDate.toISOString()}>{article.data.pubDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</time><a href={href} class="font-semibold text-blue-700">{ui.article.readMore}</a></div>
+  <div class="mt-5 flex items-center justify-between text-xs text-slate-500"><time datetime={article.data.pubDate.toISOString()}>{article.data.pubDate.toLocaleDateString(ui.locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time><a href={href} class="font-semibold text-blue-700">{ui.article.readMore}</a></div>
 </article>
\ No newline at end of file
