---
import { site } from '../../config/site.ts';
const { heading, message, button = 'Konsultasi via WhatsApp', class: css } = Astro.props;
const href = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(message)}`;
---
<section class={`rounded-2xl border border-blue-200 bg-blue-50 p-6 md:p-8 ${css?.section ?? ''}`}>
  {heading && <h2 class={`mb-2 text-xl font-bold text-slate-950 ${css?.heading ?? ''}`}>{heading}</h2>}
  <p class={`mb-5 text-slate-700 ${css?.message ?? ''}`}>{message}</p>
  <a href={href} target="_blank" rel="noopener noreferrer"
     class={`inline-flex items-center gap-2 rounded-lg bg-green-600 px-5 py-2.5 font-semibold text-white transition hover:bg-green-700 ${css?.button ?? ''}`}>
    {button}
  </a>
</section>
