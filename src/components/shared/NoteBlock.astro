---
const { variant = 'info', title, text, class: css } = Astro.props;
const variants: Record<string, string> = {
  info: 'border-blue-200 bg-blue-50 text-blue-900',
  success: 'border-emerald-200 bg-emerald-50 text-emerald-900',
  warning: 'border-amber-200 bg-amber-50 text-amber-900',
  danger: 'border-red-200 bg-red-50 text-red-900',
};
const variantClass = variants[variant];
---
<div class={`rounded-xl border px-5 py-4 ${variantClass} ${css?.section ?? ''}`}>
  {(title || text) && <div class={`font-semibold ${css?.title ?? ''}`}>{title ?? variant.toUpperCase()}</div>}
  {text && <p class={`mt-1 text-sm leading-relaxed ${css?.text ?? ''}`}>{text}</p>}
</div>
