---
/**
 * ContactPanel — contact section with WhatsApp links and consultation form.
 *
 * Props:
 * - id: string — anchor id
 * - title: string — section title
 * - intro: string — intro text
 * - contacts: Array<{label, phone, display}> — WhatsApp contacts
 * - hoursTitle: string — jam operasional title
 * - hours: string[] — jam operasional
 * - formTitle: string — form title
 * - serviceOptions: string[] — layanan options
 *
 * Usage:
 * <ContactPanel id="konsultasi" title="Konsultasi SLF/PBG" intro="..." contacts={[{label: "Konsultasi", phone: "628123456789", display: "0812-3456-789"}]} hoursTitle="Jam Operasional" hours={["Senin-Jumat: 09:00-17:00", "Sabtu: 09:00-13:00"]} formTitle="Form Konsultasi" serviceOptions={["SLF Bangunan Eksisting", "PBG Baru", "Perpanjangan SLF", "As-Built Drawing"]} />
 */
const {
  id,
  title,
  intro,
  contacts,
  hoursTitle,
  hours,
  formTitle,
  serviceOptions,
} = Astro.props as {
  id: string;
  title: string;
  intro: string;
  contacts: {label: string; phone: string; display: string}[];
  hoursTitle: string;
  hours: string[];
  formTitle: string;
  serviceOptions: string[];
};

const titleId = `${id}-title`;
const formId = `${id}-form`;
const primaryPhone = contacts[0]?.phone ?? '';
---
<section id={id} class="py-16 bg-white" aria-labelledby={titleId}>
  <div class="max-w-7xl mx-auto px-5">
    <header class="text-center mb-12">
      <h1 id={titleId} class="text-3xl font-bold text-slate-950 mb-4">{title}</h1>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">{intro}</p>
    </header>
    <div class="grid lg:grid-cols-2 gap-12">
      <div class="space-y-8">
        <div class="bg-slate-50 p-8 rounded-xl border border-slate-200">
          <h2 class="text-xl font-bold text-slate-950 mb-4">Konsultasi Cepat via WhatsApp</h2>
          <div class="space-y-4">
            {contacts.map((contact: {label: string; phone: string; display: string}) => (
              <a href={`https://wa.me/${contact.phone}`} target="_blank" rel="noopener noreferrer" class="block p-4 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors shadow-sm">
                <span class="font-bold text-lg">{contact.label}: {contact.display}</span>
              </a>
            ))}
          </div>
        </div>
        <div class="bg-slate-50 p-8 rounded-xl border border-slate-200 space-y-4">
          <h2 class="text-xl font-bold text-slate-950">{hoursTitle}</h2>
          <ul class="space-y-2 text-sm text-slate-600">
            {hours.map((hour: string) => <li>{hour}</li>)}
          </ul>
        </div>
      </div>
      <div class="bg-slate-50 p-8 rounded-xl border border-slate-200">
        <h2 class="text-xl font-bold text-slate-950 mb-6">{formTitle}</h2>
        <form id={formId} data-contact-form data-whatsapp={primaryPhone} class="space-y-4">
          <div>
            <label for={`${formId}-name`} class="block text-sm font-medium text-slate-700 mb-1">Nama Lengkap</label>
            <input id={`${formId}-name`} name="name" type="text" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" placeholder="Nama Anda" />
          </div>
          <div>
            <label for={`${formId}-company`} class="block text-sm font-medium text-slate-700 mb-1">Nama Perusahaan</label>
            <input id={`${formId}-company`} name="company" type="text" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" placeholder="Nama perusahaan" />
          </div>
          <div>
            <label for={`${formId}-phone`} class="block text-sm font-medium text-slate-700 mb-1">Nomor WhatsApp / Telepon</label>
            <input id={`${formId}-phone`} name="phone" type="tel" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" placeholder="08xxxxxxxxxx" />
          </div>
          <div>
            <label for={`${formId}-service`} class="block text-sm font-medium text-slate-700 mb-1">Pilih Layanan</label>
            <select id={`${formId}-service`} name="service" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500">
              {serviceOptions.map((service: string) => <option value={service}>{service}</option>)}
            </select>
          </div>
          <div>
            <label for={`${formId}-message`} class="block text-sm font-medium text-slate-700 mb-1">Pesan / Detail Kebutuhan</label>
            <textarea id={`${formId}-message`} name="message" rows="4" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" placeholder="Jelaskan kebutuhan SLF/PBG Anda..."></textarea>
          </div>
          <button type="submit" class="w-full py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
            Lanjutkan ke WhatsApp
          </button>
          <p class="text-xs text-slate-500">Pesan akan disiapkan di WhatsApp; formulir ini tidak mengirim data ke server situs.</p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const formData = new FormData(form);
      const message = [
        'Permintaan konsultasi SLF/PBG',
        'Nama: ' + String(formData.get('name') || ''),
        'Perusahaan: ' + String(formData.get('company') || ''),
        'Nomor kontak: ' + String(formData.get('phone') || ''),
        'Layanan: ' + String(formData.get('service') || ''),
        'Detail kebutuhan: ' + String(formData.get('message') || ''),
      ].join(String.fromCharCode(10));
      const phone = form.dataset.whatsapp;
      if (phone) window.open('https://wa.me/' + phone + '?text=' + encodeURIComponent(message), '_blank', 'noopener,noreferrer');
    });
  });
</script>