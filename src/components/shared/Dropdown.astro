---
/**
 * Dropdown — click-triggered dropdown menu.
 *
 * Props:
 * - label?: string — trigger button label (default: 'Menu')
 * - align?: 'left' | 'right' — dropdown alignment (default: 'right')
 *
 * Usage:
 * <Dropdown label="Opsi">
 *   <a href="/link-1" class="dropdown-item">Item 1</a>
 *   <a href="/link-2" class="dropdown-item">Item 2</a>
 * </Dropdown>
 */
const { label = 'Menu', align = 'right' } = Astro.props;
const alignClass = align === 'left' ? 'dropdown-start' : 'dropdown-end';
---
<div class={`dropdown ${alignClass}`}>
  <label tabindex="0" class="btn m-1">
    {label}
    <svg class="h-4 w-4 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
      <path d="M9 12h2l-3 3-.5-.5L7 12H5l3-3 3 3z"/>
      <path d="M5 8l3 3 3-3M5 12l3 3 3-3" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </label>
  <ul tabindex="0" class="dropdown-content menu p-2 shadow-lg bg-white border border-slate-200 rounded-xl w-52 z-50">
    <slot />
  </ul>
</div>
