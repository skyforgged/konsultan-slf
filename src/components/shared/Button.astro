---
/**
 * Button — styled action button.
 *
 * Props:
 * - variant?: 'primary' | 'secondary' | 'ghost' | 'outline' — style (default: 'primary')
 * - size?: 'sm' | 'md' | 'lg' — size (default: 'md')
 * - block?: boolean — full-width (default: false)
 * - disabled?: boolean — disabled state
 * - type?: 'button' | 'submit' | 'reset'
 *
 * Usage:
 * <Button variant="primary" onclick={() => {}}>Submit</Button>
 * <Button variant="ghost" size="sm">Batal</Button>
 */
const {
  variant = 'primary',
  size = 'md',
  block = false,
  disabled = false,
  type = 'button',
} = Astro.props;

const variants: Record<string, string> = {
  primary: 'bg-blue-600 text-white hover:bg-blue-700 disabled:bg-slate-300',
  secondary: 'bg-slate-100 text-slate-700 hover:bg-slate-200 disabled:bg-slate-50',
  ghost: 'bg-transparent text-slate-700 hover:bg-slate-100 disabled:text-slate-400',
  outline: 'border border-slate-300 text-slate-700 hover:bg-slate-50 disabled:border-slate-200',
};

const sizes: Record<string, string> = {
  sm: 'text-sm px-3 py-1.5',
  md: 'text-base px-4 py-2',
  lg: 'text-lg px-6 py-3',
};
---
<button
  type={type}
  disabled={disabled}
  class={`inline-flex items-center justify-center font-semibold rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:cursor-not-allowed ${variants[variant] ?? variants.primary} ${sizes[size] ?? sizes.md} ${block ? 'w-full' : ''}`}
>
  <slot />
</button>
