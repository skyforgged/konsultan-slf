---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import '../styles/global.css';
const { article, headings = [] } = Astro.props as {
  article: CollectionEntry<'articles'>;
  headings?: Array<{ depth: number; text: string; slug: string }>;
};
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const pageTitle = article.data.title;
const description = article.data.description;
const canonical = `/articles/${article.data.slug}/`;
---
<BaseLayout title={pageTitle} description={description} canonical={canonical} image={article.data.image ?? '/images/og-default.svg'}>
  <header class="border-b border-slate-200 bg-white">
    <nav class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4" aria-label="Navigasi artikel">
      <a href="/" class="font-extrabold text-slate-950 no-underline">Konsultan SLF &amp; PBG</a>
      <div class="flex items-center gap-5 text-sm font-semibold">
        <a href="/services/" class="text-slate-600 no-underline hover:text-blue-800">Layanan</a>
        <a href="/articles/" class="text-slate-600 no-underline hover:text-blue-800">Artikel</a>
      </div>
    </nav>
  </header>
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 px-5 py-10 lg:grid-cols-[250px_minmax(0,1fr)] lg:py-14">
    {tocItems.length > 0 && (
      <aside class="self-start lg:sticky lg:top-6">
        <details class="rounded-xl border border-slate-200 p-4 lg:hidden">
          <summary class="cursor-pointer font-semibold text-slate-800">Daftar isi artikel</summary>
          <nav class="mt-3" aria-label="Daftar isi artikel">
            <ul class="space-y-2 pl-4 text-sm">
              {tocItems.map((item) => <li class={item.depth === 3 ? 'ml-4' : ''}><a class="text-slate-600 hover:text-blue-700" href={`#${item.slug}`}>{item.text}</a></li>)}
            </ul>
          </nav>
        </details>
        <nav class="hidden lg:block" aria-label="Daftar isi artikel">
          <p class="mb-3 text-xs font-bold uppercase tracking-wider text-slate-400">Daftar isi</p>
          <ul class="space-y-2 border-l border-slate-200 pl-4">
            {tocItems.map((item) => <li class={item.depth === 3 ? 'ml-4' : ''}><a class="text-sm text-slate-600 no-underline hover:text-blue-700" href={`#${item.slug}`}>{item.text}</a></li>)}
          </ul>
        </nav>
      </aside>
    )}
    <article class="prose-content min-w-0">
      <header class="mb-8 border-b border-slate-200 pb-7">
        {article.data.category && <p class="text-xs font-bold uppercase tracking-wider text-blue-700">{article.data.category}</p>}
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950 md:text-4xl">{pageTitle}</h1>
        <p class="mt-4 text-lg leading-7 text-slate-600">{description}</p>
        <div class="mt-4 flex flex-wrap items-center gap-4 text-sm text-slate-500">
          <time datetime={article.data.pubDate.toISOString()}>{article.data.pubDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
          {article.data.updatedDate && <span>Diperbarui: {article.data.updatedDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</span>}
          {article.data.author && <span>Penulis: {article.data.author}</span>}
        </div>
      </header>
      <div class="prose-content [&>h2]:scroll-mt-24 [&>h3]:scroll-mt-24"><slot /></div>
    </article>
  </div>
  <footer class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 px-5 py-7 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between">
      <span>Konsultan SLF &amp; PBG</span>
      <a href="/articles/" class="font-semibold text-blue-700 no-underline hover:text-blue-900">Kembali ke artikel</a>
    </div>
  </footer>
</BaseLayout>