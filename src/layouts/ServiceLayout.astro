---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { getCollection } from 'astro:content';
import RelatedArticles from '../components/shared/RelatedArticles.astro';
import SiteHeader from '../components/shared/SiteHeader.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import { ui } from '../config/ui.ts';
import { howToJsonLd } from '../utils/howto.ts';
import '../styles/global.css';

const { service } = Astro.props as { service: CollectionEntry<'services'> };
const articles = await getCollection('articles');
const pageTitle = service.data.title;
const description = service.data.description;
const canonical = `/services/${service.data.slug}/`;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? Astro.url.origin;
const serviceUrl = new URL(canonical, siteUrl).toString();
const serviceImageSource = service.data.socialImage ?? ui.meta.defaultImage;
const isRasterImage = /\.(png|jpe?g|webp|gif)$/i.test(serviceImageSource.split(/[?#]/)[0]);
const serviceImage = new URL(isRasterImage ? serviceImageSource : ui.meta.defaultImage, siteUrl).toString();
const utcIso = (date: Date) => date.toISOString().replace(/\.\d{3}Z$/, 'Z');
// HowTo opsional: dirakit dari blok prosedural (steps/process-timeline) yang dirujuk frontmatter `howTo`.
const howToNode = service.data.howTo ? howToJsonLd({
  pageUrl: serviceUrl,
  name: service.data.howTo.name ?? pageTitle,
  description: service.data.howTo.description ?? description,
  howTo: service.data.howTo,
  blocks: service.data.blocks,
}) : null;
// FAQPage diturunkan hanya dari seluruh FAQ yang juga dirender pada halaman layanan.
const faqItems = service.data.blocks
  .filter((block) => block.component === 'faq')
  .flatMap((block) => block.items);
const faqJsonLd = faqItems.length > 0 ? {
  '@type': 'FAQPage',
  '@id': `${serviceUrl}#faq`,
  inLanguage: 'id-ID',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;
const serviceJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${serviceUrl}#service`,
      name: pageTitle,
      description,
      image: [serviceImage],
      url: serviceUrl,
      mainEntityOfPage: { '@type': 'WebPage', '@id': `${serviceUrl}#webpage` },
      serviceType: pageTitle,
      provider: { '@id': `${siteUrl}/#organization` },
      ...(service.data.serviceArea?.length ? { areaServed: service.data.serviceArea } : {}),
    },
    ...(faqJsonLd ? [faqJsonLd] : []),
    ...(howToNode ? [howToNode] : []),
  ],
}).replace(/</g, '\\u003c');
---
<BaseLayout title={pageTitle} description={description} canonical={canonical} socialImage={service.data.socialImage ?? ui.meta.defaultImage} imageAlt={service.data.image ? service.data.imageAlt : ui.article.socialImageAlt} pubDate={service.data.pubDate} updatedDate={service.data.updatedDate} mainEntityId={`${serviceUrl}#service`}>
  <script slot="head" type="application/ld+json" set:html={serviceJsonLd}></script>
  <SiteHeader />
  <main id="main-content" class="mx-auto max-w-7xl px-5 py-10 sm:py-12 lg:py-14">
    <article class="prose-content min-w-0">
      <header class="mb-10 grid items-center gap-8 border-b border-slate-200 pb-9 md:grid-cols-[1.1fr_0.9fr] md:gap-12">
        <div class="max-w-3xl">
          {service.data.eyebrow && <p class="text-xs font-bold uppercase tracking-wider text-blue-700">{service.data.eyebrow}</p>}
          <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950 md:text-4xl lg:text-5xl">{pageTitle}</h1>
          <p class="mt-4 text-lg leading-8 text-slate-600">{description}</p>
          <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm text-slate-500">
            <time datetime={utcIso(service.data.pubDate)}>{service.data.pubDate.toLocaleDateString(ui.locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' })}</time>
            <span>{ui.article.updatedPrefix} {service.data.updatedDate.toLocaleDateString(ui.locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' })}</span>
          </div>
        </div>
        <img src={service.data.image ?? ui.services.defaultImage} alt={service.data.imageAlt} class="mx-auto w-full max-w-xl rounded-2xl object-contain" width="560" height="420" fetchpriority="high" />
      </header>
      <div class="prose-content [&>h2]:scroll-mt-24 [&>h3]:scroll-mt-24"><slot /></div>
      <slot name="related" />
    </article>
    <section id="service-cta" class="full-width-section border-t border-slate-200 bg-blue-50/60 my-8">
    <div class="mx-auto flex max-w-7xl flex-col gap-5 px-5 py-10 sm:flex-row sm:items-center sm:justify-between lg:py-12">
      <div class="max-w-2xl">
        <h2 class="text-xl font-extrabold tracking-tight text-slate-950">{ui.article.ctaHeading}</h2>
        <p class="mt-2 leading-7 text-slate-600">{ui.article.ctaText}</p>
      </div>
      <a href="/services/" class="inline-flex shrink-0 items-center justify-center rounded-lg bg-blue-700 px-5 py-3 text-sm font-bold text-white no-underline transition hover:bg-blue-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700">{ui.article.ctaButton}</a>
    </div>
  </section>
<RelatedArticles slot="related" articles={articles} type="service" id={service.data.id} heading="Artikel terkait layanan" />
</main>
  <SiteFooter group={service.data.serviceGroup} serviceTitle={pageTitle} />
</BaseLayout>
