---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui } from '../config/ui.ts';
const page = await getEntry('pages', '404');
if (!page) throw new Error('Missing "404" page content entry.');
const notFound = page.data.notFound;
if (!notFound) throw new Error('Missing "404" page content.');
---
<BaseLayout
  title={page.data.seoTitle ?? page.data.title}
  description={page.data.description}
  noindex={page.data.noindex}
>
  <header class="border-b border-slate-200 bg-white">
    <nav class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4" aria-label={ui.nav.pageAriaLabel}>
      <a href="/" class="inline-flex items-center no-underline">
        <img src="/images/logo-konsultan-slf-pbg.svg" alt={ui.brand.logoAlt} class="h-9 w-auto max-w-[190px]" width="760" height="150" />
      </a>
      <div class="flex items-center gap-5 text-sm font-semibold">
        <a href="/services/" class="text-slate-600 no-underline hover:text-blue-800">{ui.nav.services}</a>
        <a href="/articles/" class="text-slate-600 no-underline hover:text-blue-800">{ui.nav.articles}</a>
      </div>
    </nav>
  </header>
  <main class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-center justify-center px-5 py-20 text-center">
    <img src={notFound.image} alt="" aria-hidden="true" class="mb-8 w-full max-w-xs" width="560" height="360" />
    <p class="text-sm font-extrabold uppercase tracking-[0.16em] text-blue-700">{notFound.eyebrow}</p>
    <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">{notFound.heading}</h1>
    <p class="mt-5 max-w-xl leading-7 text-slate-600">{notFound.message}</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="inline-flex items-center justify-center rounded-lg bg-blue-900 px-6 py-3 font-bold text-white no-underline hover:bg-blue-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700">{notFound.homeCta}</a>
      <a href="/services/" class="inline-flex items-center justify-center rounded-lg border border-slate-300 px-6 py-3 font-bold text-slate-800 no-underline hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700">{notFound.servicesCta}</a>
      <a href="/articles/" class="inline-flex items-center justify-center rounded-lg border border-slate-300 px-6 py-3 font-bold text-slate-800 no-underline hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700">{notFound.articlesCta}</a>
    </div>
  </main>
  <footer class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto flex max-w-7xl flex-col gap-4 px-5 py-7 sm:flex-row sm:items-center sm:justify-between">
      <a href="/" class="inline-flex items-center no-underline">
        <img src="/images/logo-konsultan-slf-pbg.svg" alt={ui.brand.logoAlt} class="h-8 w-auto max-w-[180px]" width="760" height="150" loading="lazy" />
      </a>
      <p class="text-sm text-slate-500">{ui.footer.tagline}</p>
    </div>
  </footer>
</BaseLayout>
