---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import { ui } from '../config/ui.ts';
const page = await getEntry('pages', 'kontak');
if (!page) throw new Error('Missing "kontak" page content entry.');
const header = page.data.pageHeader;
if (!header) throw new Error('Missing "kontak" page content header.');
---
<BaseLayout title={page.data.seoTitle ?? page.data.title} description={page.data.description} canonical={page.data.canonical} noindex={page.data.noindex}>
  <header class="border-b border-slate-200 bg-white">
    <nav class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4" aria-label={ui.nav.pageAriaLabel}>
      <a href="/" class="inline-flex items-center no-underline"><img src="/images/logo-konsultan-slf-pbg.svg" alt={ui.brand.logoAlt} class="h-9 w-auto max-w-[190px]" width="760" height="150" /></a>
      <div class="flex items-center gap-5 text-sm font-semibold">
        <a href="/" class="text-slate-600 no-underline hover:text-blue-800">{ui.nav.home}</a>
        <a href="/services/" class="text-slate-600 no-underline hover:text-blue-800">{ui.nav.services}</a>
        <a href="/articles/" class="text-slate-600 no-underline hover:text-blue-800">{ui.nav.articles}</a>
      </div>
    </nav>
  </header>
  <main class="mx-auto max-w-7xl px-5 py-12 sm:py-16">
    <header class="grid items-center gap-8 md:grid-cols-[1.1fr_0.9fr]">
      <div class="max-w-3xl">
        <p class="text-sm font-extrabold uppercase tracking-wider text-blue-700">{header.eyebrow}</p>
        <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950">{header.heading}</h1>
        <p class="mt-4 text-lg leading-8 text-slate-600">{header.intro}</p>
      </div>
      <img src={header.image} alt={header.imageAlt} class="mx-auto w-full max-w-md" width="560" height="420" fetchpriority="high" />
    </header>
    {page.data.blocks.map((block) => <BlockRenderer block={block} />)}
  </main>
  <footer class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto flex max-w-7xl flex-col gap-4 px-5 py-7 sm:flex-row sm:items-center sm:justify-between">
      <a href="/" class="inline-flex items-center no-underline"><img src="/images/logo-konsultan-slf-pbg.svg" alt={ui.brand.logoAlt} class="h-8 w-auto max-w-[180px]" width="760" height="150" loading="lazy" /></a>
      <p class="text-sm text-slate-500">{ui.footer.tagline}</p>
    </div>
  </footer>
</BaseLayout>
