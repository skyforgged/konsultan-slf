---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import SiteHeader from '../components/shared/SiteHeader.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
const page = await getEntry('pages', 'kontak');
if (!page) throw new Error('Missing "kontak" page content entry.');
const header = page.data.pageHeader;
if (!header) throw new Error('Missing "kontak" page content header.');
---
<BaseLayout title={page.data.seoTitle ?? page.data.title} description={page.data.description} canonical={page.data.canonical} noindex={page.data.noindex}>
    <SiteHeader />
  <main class="mx-auto max-w-7xl px-5 py-12 sm:py-16">
    <header class="grid items-center gap-8 md:grid-cols-[1.1fr_0.9fr]">
      <div class="max-w-3xl">
        <p class="text-sm font-extrabold uppercase tracking-wider text-blue-700">{header.eyebrow}</p>
        <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950">{header.heading}</h1>
        <p class="mt-4 text-lg leading-8 text-slate-600">{header.intro}</p>
      </div>
      <img src={header.image} alt={header.imageAlt} class="mx-auto w-full max-w-md" width="560" height="420" fetchpriority="high" />
    </header>
    {page.data.blocks.map((block) => <BlockRenderer block={block} />)}
  </main>
    <SiteFooter />
</BaseLayout>
