---
import { getEntry } from 'astro:content';
import SiteHeader from '../../components/shared/SiteHeader.astro';
import SiteFooter from '../../components/shared/SiteFooter.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';
const page = await getEntry('pages', 'articles');
if (!page) throw new Error('Missing "articles" page content entry.');
if (page.data.draft) throw new Error('Page "articles" is marked draft but has a statically defined route.');
---
<BaseLayout title={page.data.seoTitle ?? page.data.title} description={page.data.description} canonical={page.data.canonical} noindex={page.data.noindex} pubDate={page.data.pubDate} updatedDate={page.data.updatedDate}>
  <SiteHeader />
  <main id="main-content" class="mx-auto max-w-7xl px-5 py-12 sm:py-16">
    <div class="space-y-8">
      {page.data.blocks.map((block) => <BlockRenderer block={block} />)}
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
