---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageUpdatedArticles from '../components/shared/PageUpdatedArticles.astro';
import SiteHeader from '../components/shared/SiteHeader.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import { ui } from '../config/ui.ts';
import { validateContentRelations } from '../utils/content-validation';

await validateContentRelations();
const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing "home" page content entry.');
if (home.data.draft) throw new Error('Page "home" is marked draft but has a statically defined route.');
const hero = home.data.hero;
const sections = home.data.homeSections;
if (!hero || !sections) throw new Error('Missing "home" page content sections.');
const jsonLd = home.data.jsonLd;
if (!jsonLd) throw new Error('Missing "home" page JSON-LD content.');
const articles = await getCollection('articles');
const services = (await getCollection('services'))
  .filter((service) => !service.data.draft && service.data.status === 'active')
  .sort((a, b) => a.data.order - b.data.order);
const serviceBenefitItems = (service: (typeof services)[number]) => {
  const block = service.data.blocks.find((item) => item.component === 'feature-card-grid');
  return block?.items.slice(0, 3).map((item) => item.title) ?? [];
};
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? Astro.url.origin;
const organizationJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: jsonLd.organizationName,
      url: siteUrl,
      description: jsonLd.organizationDescription,
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: jsonLd.websiteName,
      url: siteUrl,
      inLanguage: ui.locale,
      publisher: { '@id': `${siteUrl}/#organization` },
    },
  ],
}).replace(/</g, '\\u003c');
---

<BaseLayout
  title={home.data.seoTitle ?? home.data.title}
  description={home.data.description}
  canonical={home.data.canonical}
  noindex={home.data.noindex}
>
  <script slot="head" type="application/ld+json" set:html={organizationJsonLd}></script>
    <SiteHeader variant="home" />


  <main id="main-content">
    <section class="relative isolate overflow-hidden bg-slate-950 text-white">
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-blue-800/50 via-slate-950 to-slate-950"></div>
      <div class="mx-auto grid max-w-7xl gap-12 px-5 py-20 md:grid-cols-[1.15fr_0.85fr] md:items-center md:py-28">
        <div>
          <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-blue-300/30 bg-blue-400/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.18em] text-blue-200">
            {hero.eyebrow}
          </p>
          <h1 class="max-w-3xl text-4xl font-black leading-tight tracking-tight sm:text-5xl lg:text-6xl">
            {hero.titleLead} <span class="text-blue-300">{hero.titleHighlight}</span>
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
            {hero.description}
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href={hero.primaryHref} class="inline-flex items-center justify-center rounded-lg bg-blue-500 px-6 py-3.5 font-bold text-white no-underline transition hover:bg-blue-400">{hero.primaryCta} <span class="ml-2" aria-hidden="true">→</span></a>
            <a href={hero.secondaryHref} class="inline-flex items-center justify-center rounded-lg border border-white/25 px-6 py-3.5 font-bold text-white no-underline transition hover:bg-white/10">{hero.secondaryCta}</a>
          </div>
          <p class="mt-6 text-sm text-slate-400">{hero.note}</p>
        </div>
        <div class="relative">
          <img src={hero.image} alt={hero.imageAlt} class="mx-auto mb-2 h-auto max-h-48 w-full max-w-60 object-contain" width="640" height="520" fetchpriority="high" />
          <div class="rounded-2xl border border-white/15 bg-white/[0.06] p-6 shadow-2xl backdrop-blur-sm sm:p-8">
            <h2 class="text-sm font-bold uppercase tracking-[0.16em] text-blue-200">{hero.supportEyebrow}</h2>
            <div class="mt-6 space-y-4">
              {hero.supportItems.map((item) => (
                <div class="flex gap-4 rounded-xl border border-white/10 bg-slate-900/70 p-4">
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-blue-400/15 text-xl text-blue-200" aria-hidden="true">{item.number}</span>
                  <div><h3 class="font-bold text-white">{item.title}</h3><p class="mt-1 text-sm leading-6 text-slate-300">{item.text}</p></div>
                </div>
              ))}
            </div>
          </div>
          <div class="absolute -right-3 -top-3 -z-10 h-28 w-28 rounded-full bg-blue-500/30 blur-3xl"></div>
        </div>
      </div>
    </section>

    <section id="layanan" class="scroll-mt-8 bg-white py-20 sm:py-24">
      <div class="mx-auto max-w-7xl px-5">
        <div class="max-w-2xl">
          <p class="text-sm font-extrabold uppercase tracking-[0.16em] text-blue-700">{sections.services.eyebrow}</p>
          <h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">{sections.services.heading}</h2>
          <p class="mt-4 leading-7 text-slate-600">{sections.services.description}</p>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {services.map((service, index) => (
            <article class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 transition hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl hover:shadow-slate-200/60">
              <p class="text-sm font-black tracking-widest text-blue-700">{String(index + 1).padStart(2, '0')}</p>
              <h3 class="mt-4 text-xl font-extrabold leading-snug text-slate-950">{service.data.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-7 text-slate-600">{service.data.description}</p>
              {serviceBenefitItems(service).length > 0 && <ul class="mt-5 space-y-3 border-t border-slate-100 pt-5 text-sm text-slate-700">{serviceBenefitItems(service).map((point) => <li class="flex gap-2"><span class="font-bold text-blue-700" aria-hidden="true">✓</span><span>{point}</span></li>)}</ul>}
              <a href={`/services/${service.data.slug}/`} class="mt-6 font-bold text-blue-700 no-underline hover:text-blue-900">{ui.services.readMore}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="proses" class="scroll-mt-8 border-y border-slate-200 bg-slate-50 py-20 sm:py-24">
      <div class="mx-auto max-w-7xl px-5">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-sm font-extrabold uppercase tracking-[0.16em] text-blue-700">{sections.process.eyebrow}</p>
          <h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">{sections.process.heading}</h2>
          <p class="mt-4 leading-7 text-slate-600">{sections.process.description}</p>
        </div>
        <div class="mt-12 grid gap-8 md:grid-cols-3">
          {sections.process.steps.map((step, index) => (
            <div class="relative border-l-2 border-blue-200 pl-6">
              <span class="text-xs font-black tracking-[0.2em] text-blue-700">{sections.process.stepPrefix} {String(index + 1).padStart(2, '0')}</span>
              <h3 class="mt-3 text-xl font-extrabold text-slate-950">{step.title}</h3>
              <p class="mt-3 leading-7 text-slate-600">{step.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <PageUpdatedArticles articles={articles} heading={sections.articles.heading} description={sections.articles.description} />

    <section id="konsultasi" class="scroll-mt-8 px-5 pb-20">
      <div class="mx-auto max-w-7xl overflow-hidden rounded-2xl bg-blue-950 px-6 py-10 text-white sm:px-10 sm:py-14 lg:flex lg:items-center lg:justify-between lg:gap-10">
        <div class="max-w-2xl">
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-blue-300">{sections.consult.eyebrow}</p>
          <h2 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">{sections.consult.heading}</h2>
          <p class="mt-4 leading-7 text-blue-100">{sections.consult.description}</p>
        </div>
        <a href="/services/" class="mt-7 inline-flex shrink-0 items-center justify-center rounded-lg bg-white px-6 py-3.5 font-bold text-blue-950 no-underline transition hover:bg-blue-50 lg:mt-0">{sections.consult.ctaLabel} <span class="ml-2" aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>

    <SiteFooter />

</BaseLayout>
