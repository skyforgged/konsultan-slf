---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageUpdatedArticles from '../components/shared/PageUpdatedArticles.astro';
import { validateContentRelations } from '../utils/content-validation';

await validateContentRelations();
const articles = await getCollection('articles');
const services = (await getCollection('services'))
  .filter((service) => !service.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? Astro.url.origin;
const organizationJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Konsultan SLF & PBG',
      url: siteUrl,
      description: 'Konsultan pendampingan Sertifikat Laik Fungsi (SLF), Persetujuan Bangunan Gedung (PBG), dan evaluasi dokumen bangunan.',
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'Konsultan SLF & PBG',
      url: siteUrl,
      inLanguage: 'id-ID',
      publisher: { '@id': `${siteUrl}/#organization` },
    },
  ],
}).replace(/</g, '\\u003c');
---

<BaseLayout
  title="Konsultan SLF & PBG | Pendampingan Perizinan Bangunan"
  description="Konsultan pendampingan Sertifikat Laik Fungsi (SLF), Persetujuan Bangunan Gedung (PBG), dan evaluasi dokumen bangunan."
>
  <script slot="head" type="application/ld+json" set:html={organizationJsonLd}></script>
  <header class="border-b border-slate-200 bg-white">
    <nav class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-4" aria-label="Navigasi utama">
      <a href="/" class="flex items-center gap-3 no-underline">
        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-900 text-sm font-black tracking-tight text-white">SLF</span>
        <span class="leading-tight">
          <span class="block text-base font-extrabold text-slate-950">Konsultan SLF</span>
          <span class="block text-xs font-medium text-slate-500">Solusi perizinan bangunan</span>
        </span>
      </a>
      <div class="hidden items-center gap-7 text-sm font-semibold text-slate-600 md:flex">
        <a class="no-underline transition hover:text-blue-800" href="#layanan">Layanan</a>
        <a class="no-underline transition hover:text-blue-800" href="#proses">Alur Pendampingan</a>
        <a class="no-underline transition hover:text-blue-800" href="/articles/">Artikel</a>
      </div>
      <a href="#konsultasi" class="rounded-lg bg-blue-900 px-4 py-2.5 text-sm font-bold text-white no-underline transition hover:bg-blue-800">Konsultasi</a>
    </nav>
  </header>

  <main>
    <section class="relative isolate overflow-hidden bg-slate-950 text-white">
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-blue-800/50 via-slate-950 to-slate-950"></div>
      <div class="mx-auto grid max-w-7xl gap-12 px-5 py-20 md:grid-cols-[1.15fr_0.85fr] md:items-center md:py-28">
        <div>
          <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-blue-300/30 bg-blue-400/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.18em] text-blue-200">
            Pendampingan SLF & PBG
          </p>
          <h1 class="max-w-3xl text-4xl font-black leading-tight tracking-tight sm:text-5xl lg:text-6xl">
            Urus perizinan bangunan dengan <span class="text-blue-300">lebih terarah.</span>
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
            Pendampingan untuk memahami persyaratan, menyiapkan dokumen, dan menjalani proses Sertifikat Laik Fungsi (SLF) serta Persetujuan Bangunan Gedung (PBG).
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href="#konsultasi" class="inline-flex items-center justify-center rounded-lg bg-blue-500 px-6 py-3.5 font-bold text-white no-underline transition hover:bg-blue-400">Diskusikan Kebutuhan Anda <span class="ml-2" aria-hidden="true">→</span></a>
            <a href="#layanan" class="inline-flex items-center justify-center rounded-lg border border-white/25 px-6 py-3.5 font-bold text-white no-underline transition hover:bg-white/10">Lihat layanan</a>
          </div>
          <p class="mt-6 text-sm text-slate-400">Kebutuhan setiap bangunan berbeda. Mulai dengan memahami kondisi dan persyaratan proyek Anda.</p>
        </div>
        <div class="relative">
          <img src="/images/illustrations/building-compliance.svg" alt="Ilustrasi bangunan dan dokumen kepatuhan" class="mx-auto mb-2 h-auto max-h-48 w-full max-w-60 object-contain" width="640" height="520" fetchpriority="high" />
          <div class="rounded-2xl border border-white/15 bg-white/[0.06] p-6 shadow-2xl backdrop-blur-sm sm:p-8">
            <p class="text-sm font-bold uppercase tracking-[0.16em] text-blue-200">Dukungan untuk proses Anda</p>
            <div class="mt-6 space-y-4">
              <div class="flex gap-4 rounded-xl border border-white/10 bg-slate-900/70 p-4">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-blue-400/15 text-xl text-blue-200" aria-hidden="true">01</span>
                <div><h2 class="font-bold text-white">Pemetaan kebutuhan</h2><p class="mt-1 text-sm leading-6 text-slate-300">Kenali jenis layanan dan dokumen yang perlu dipersiapkan.</p></div>
              </div>
              <div class="flex gap-4 rounded-xl border border-white/10 bg-slate-900/70 p-4">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-blue-400/15 text-xl text-blue-200" aria-hidden="true">02</span>
                <div><h2 class="font-bold text-white">Persiapan dokumen</h2><p class="mt-1 text-sm leading-6 text-slate-300">Susun kebutuhan administrasi dan teknis secara lebih sistematis.</p></div>
              </div>
              <div class="flex gap-4 rounded-xl border border-white/10 bg-slate-900/70 p-4">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-blue-400/15 text-xl text-blue-200" aria-hidden="true">03</span>
                <div><h2 class="font-bold text-white">Pendampingan proses</h2><p class="mt-1 text-sm leading-6 text-slate-300">Pahami tahapan berikutnya sesuai kondisi bangunan dan ketentuan yang berlaku.</p></div>
              </div>
            </div>
          </div>
          <div class="absolute -right-3 -top-3 -z-10 h-28 w-28 rounded-full bg-blue-500/30 blur-3xl"></div>
        </div>
      </div>
    </section>

    <section id="layanan" class="scroll-mt-8 bg-white py-20 sm:py-24">
      <div class="mx-auto max-w-7xl px-5">
        <div class="max-w-2xl">
          <p class="text-sm font-extrabold uppercase tracking-[0.16em] text-blue-700">Layanan kami</p>
          <h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">Pendampingan sesuai kebutuhan bangunan</h2>
          <p class="mt-4 leading-7 text-slate-600">Mulai dari mengenali kebutuhan perizinan hingga menyiapkan dokumen dan memahami proses pengajuan.</p>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {services.map((service, index) => (
            <article class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 transition hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl hover:shadow-slate-200/60">
              <p class="text-sm font-black tracking-widest text-blue-700">{String(index + 1).padStart(2, '0')}</p>
              <h3 class="mt-4 text-xl font-extrabold leading-snug text-slate-950">{service.data.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-7 text-slate-600">{service.data.description}</p>
              {service.data.benefits.length > 0 && <ul class="mt-5 space-y-3 border-t border-slate-100 pt-5 text-sm text-slate-700">{service.data.benefits.slice(0, 3).map((point) => <li class="flex gap-2"><span class="font-bold text-blue-700" aria-hidden="true">✓</span><span>{point}</span></li>)}</ul>}
              <a href={`/services/${service.data.slug}/`} class="mt-6 font-bold text-blue-700 no-underline hover:text-blue-900">Pelajari layanan →</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="proses" class="scroll-mt-8 border-y border-slate-200 bg-slate-50 py-20 sm:py-24">
      <div class="mx-auto max-w-7xl px-5">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-sm font-extrabold uppercase tracking-[0.16em] text-blue-700">Alur pendampingan</p>
          <h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">Langkah yang jelas, sejak awal</h2>
          <p class="mt-4 leading-7 text-slate-600">Gambaran umum tahapan pendampingan. Proses dan persyaratan akhir mengikuti kondisi bangunan serta ketentuan instansi terkait.</p>
        </div>
        <div class="mt-12 grid gap-8 md:grid-cols-3">
          {[
            { number: '01', title: 'Konsultasi awal', text: 'Ceritakan fungsi bangunan, lokasi, status dokumen, dan kebutuhan proyek Anda.' },
            { number: '02', title: 'Evaluasi kebutuhan', text: 'Petakan dokumen dan persyaratan teknis maupun administratif yang perlu ditindaklanjuti.' },
            { number: '03', title: 'Rencana tindak lanjut', text: 'Susun tahapan kerja dan koordinasi berdasarkan ruang lingkup yang disepakati.' },
          ].map((step) => (
            <div class="relative border-l-2 border-blue-200 pl-6">
              <span class="text-xs font-black tracking-[0.2em] text-blue-700">LANGKAH {step.number}</span>
              <h3 class="mt-3 text-xl font-extrabold text-slate-950">{step.title}</h3>
              <p class="mt-3 leading-7 text-slate-600">{step.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <PageUpdatedArticles articles={articles} heading="Artikel dan panduan" description="Pelajari istilah, persyaratan, dan informasi dasar seputar SLF serta PBG." />

    <section id="konsultasi" class="scroll-mt-8 px-5 pb-20">
      <div class="mx-auto max-w-7xl overflow-hidden rounded-2xl bg-blue-950 px-6 py-10 text-white sm:px-10 sm:py-14 lg:flex lg:items-center lg:justify-between lg:gap-10">
        <div class="max-w-2xl">
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-blue-300">Langkah pertama</p>
          <h2 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">Perlu arahan untuk SLF atau PBG?</h2>
          <p class="mt-4 leading-7 text-blue-100">Siapkan informasi dasar bangunan dan dokumen yang tersedia untuk memulai diskusi kebutuhan Anda.</p>
        </div>
        <a href="/services/" class="mt-7 inline-flex shrink-0 items-center justify-center rounded-lg bg-white px-6 py-3.5 font-bold text-blue-950 no-underline transition hover:bg-blue-50 lg:mt-0">Lihat layanan konsultasi <span class="ml-2" aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>

  <footer class="border-t border-slate-200 bg-white">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 px-5 py-8 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-bold text-slate-700">Konsultan SLF & PBG</p>
      <p>Pendampingan perizinan bangunan dengan informasi yang jelas dan terarah.</p>
      <a href="/articles/" class="font-semibold text-blue-700 no-underline hover:text-blue-900">Artikel dan panduan →</a>
    </div>
  </footer>
</BaseLayout>
