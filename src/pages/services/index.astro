---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const services = (await getCollection('services')).filter((item: CollectionEntry<'services'>) => !item.data.draft).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Layanan Konsultan SLF dan PBG" description="Layanan pendampingan SLF, PBG, dan kebutuhan perizinan bangunan sesuai kondisi proyek." canonical="/services/">
  <header class="border-b border-slate-200 bg-white">
    <nav class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4" aria-label="Navigasi layanan">
      <a href="/" class="inline-flex items-center no-underline"><img src="/images/logo-konsultan-slf-pbg.svg" alt="Konsultan SLF &amp; PBG" class="h-9 w-auto max-w-[190px]" width="760" height="150" /></a>
      <div class="flex items-center gap-5 text-sm font-semibold">
        <a href="/" class="text-slate-600 no-underline hover:text-blue-800">Beranda</a>
        <a href="/articles/" class="text-slate-600 no-underline hover:text-blue-800">Artikel</a>
      </div>
    </nav>
  </header>
  <main class="mx-auto max-w-7xl px-5 py-12 sm:py-16">
    <header class="grid items-center gap-8 md:grid-cols-[1.1fr_0.9fr]">
      <div class="max-w-3xl">
        <p class="text-sm font-extrabold uppercase tracking-wider text-blue-700">Layanan</p>
        <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950">Pendampingan perizinan bangunan</h1>
        <p class="mt-4 text-lg leading-8 text-slate-600">Pahami ruang lingkup pendampingan dan persiapan awal. Kebutuhan final ditentukan berdasarkan kondisi bangunan dan ketentuan yang berlaku.</p>
      </div>
      <img src="/images/illustrations/service-certificate.svg" alt="Ilustrasi dokumen layanan dan verifikasi" class="mx-auto w-full max-w-md" width="560" height="420" fetchpriority="high" />
    </header>
    {services.length ? (
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => (
          <article class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6">
            <p class="text-xs font-bold uppercase tracking-wider text-blue-700">{service.data.serviceGroup.toUpperCase()}</p>
            <h2 class="mt-3 text-xl font-extrabold text-slate-950">{service.data.title}</h2>
            <p class="mt-3 flex-1 text-sm leading-7 text-slate-600">{service.data.description}</p>
            <a class="mt-5 font-semibold text-blue-700 no-underline hover:text-blue-900" href={`/services/${service.data.slug}/`}>Pelajari layanan →</a>
          </article>
        ))}
      </div>
    ) : (
      <p class="mt-10 rounded-xl border border-dashed border-slate-300 p-8 text-slate-500">Halaman layanan akan ditampilkan setelah konten layanan diterbitkan.</p>
    )}
  </main>
  <footer class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto flex max-w-7xl flex-col gap-4 px-5 py-7 sm:flex-row sm:items-center sm:justify-between">
      <a href="/" class="inline-flex items-center no-underline"><img src="/images/logo-konsultan-slf-pbg.svg" alt="Konsultan SLF &amp; PBG" class="h-8 w-auto max-w-[180px]" width="760" height="150" loading="lazy" /></a>
      <p class="text-sm text-slate-500">Pendampingan perizinan bangunan dengan informasi yang jelas dan terarah.</p>
    </div>
  </footer>
</BaseLayout>