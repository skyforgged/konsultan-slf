{
  "$ref": "#/definitions/pages",
  "definitions": {
    "pages": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "ulid": {
          "type": "string",
          "minLength": 26,
          "maxLength": 26
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "draft": {
          "type": "boolean",
          "default": false
        },
        "image": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "page"
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "pubDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "updatedDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "navLabel": {
          "type": "string"
        },
        "seoTitle": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "ulid",
        "title",
        "description",
        "type",
        "slug"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}