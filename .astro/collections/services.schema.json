{
  "$ref": "#/definitions/services",
  "definitions": {
    "services": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "ulid": {
          "type": "string",
          "minLength": 26,
          "maxLength": 26
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "draft": {
          "type": "boolean",
          "default": false
        },
        "image": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "service"
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "pubDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "updatedDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "serviceGroup": {
          "type": "string",
          "enum": [
            "slf",
            "pbg"
          ],
          "default": "slf"
        },
        "order": {
          "type": "integer",
          "default": 100
        },
        "benefits": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "process": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "faq": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "answer": {
                "type": "string"
              }
            },
            "required": [
              "question",
              "answer"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "ctaLabel": {
          "type": "string",
          "default": "Konsultasikan Kebutuhan Anda"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "ulid",
        "title",
        "description",
        "type",
        "slug"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}