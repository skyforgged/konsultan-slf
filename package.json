{
  "name": "konsultan-slf",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/generate-social-images.mjs",
    "check": "astro check --minimumFailingSeverity hint",
    "build": "npm run check && astro build && node scripts/check-internal-links.mjs && node scripts/check-seo-output.mjs && node scripts/check-published-content.mjs",
    "preview": "astro preview",
    "hooks:install": "git config core.hooksPath .githooks",
    "content:dates": "node scripts/update-content-dates.mjs",
    "content:update:ai": "node scripts/update-content-ai.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.4.0",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
